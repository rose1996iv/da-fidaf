# Enforce consistent LF line endings across Windows and Linux
* text=auto eol=lf

# Explicit text formats
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.bib text eol=lf
*.cff text eol=lf
*.svg text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.python-version text eol=lf
.env.example text eol=lf

# Windows PowerShell scripts (if added later)
*.ps1 text eol=crlf

# Binary file handling
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.eps binary
*.ico binary
*.whl binary
*.zip binary
*.7z binary
*.gz binary
*.pcap binary
*.pcapng binary
